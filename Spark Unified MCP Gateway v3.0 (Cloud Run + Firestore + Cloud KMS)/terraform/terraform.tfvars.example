# ==============================================================================
# Spark Unified MCP Gateway v3.0 - Terraform Variables Example
# ==============================================================================
# Copy this file to terraform.tfvars and fill in your environment values:
# cp terraform.tfvars.example terraform.tfvars
# ==============================================================================

project_id             = "spark-mcp-gateway-v3"
project_number         = "515472562394"
region                 = "asia-southeast1"
service_name           = "spark-mcp-gateway"
firestore_database_id  = "spark-mcp-db"
admin_allowed_emails   = "brendon.ang20011007@gmail.com"

# Initial seed container image (CI overwrites this on merge via Cloud Run revision deploy)
container_image        = "us-docker.pkg.dev/cloudrun/container/hello"

# Optional Custom Domain (leave empty to use https://${service_name}-${project_number}.${region}.run.app)
custom_domain                = ""
enable_custom_domain_mapping = false

# Optional Billing Account for $25/mo budget alerts (leave empty to skip)
billing_account_id           = ""

# Google OIDC for Admin Login (Google Cloud Console -> APIs & Services -> Credentials)
google_oidc_client_id        = "515472562394-xxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com"
google_oidc_client_secret    = "GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx"

# GitHub OAuth App credentials (https://github.com/settings/developers)
github_oauth_client_id       = "Ov23xxxxxxxxxxxxxxxx"
github_oauth_client_secret   = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
github_allowed_write_repos   = "brendonang/Google Cloud Project"

# Atlassian / Jira OAuth 2.0 (3LO) App credentials (https://developer.atlassian.com/console/myapps)
jira_oauth_client_id         = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
jira_oauth_client_secret     = "ATOAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# GitHub Actions deployer SA pre-bootstrapped in spark-mcp-gateway-v3
existing_gh_deployer_sa_email = "gh-deployer@spark-mcp-gateway-v3.iam.gserviceaccount.com"
create_wif_pool               = false
